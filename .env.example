# supabase status -o env の値を入れる（ローカル）。本番は Supabase プロジェクトの値。
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55621
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー専用。ブラウザへ渡さないこと（NEXT_PUBLIC_ を付けない）
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3080
# ローカルのデモデータ（scripts/seed-dev.mjs）用
DEV_LOGIN_EMAIL=demo-owner@npo-crm.test
DEV_LOGIN_PASSWORD=
