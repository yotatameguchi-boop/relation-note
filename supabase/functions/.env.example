# supabase functions serve --env-file supabase/functions/.env
WORKER_SECRET=change-me
# rekognition | mock（開発用。実際の検出は行わない）
DETECTOR=mock
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DETECTOR_MIN_CONFIDENCE=60
# 写真解析 v2
# API には低めのスコアの候補まで返させ、アプリ側の min_score で数える
DETECTOR_CANDIDATE_MIN_CONFIDENCE=40
# 1ジョブあたりの外部API呼び出し上限（全体1回＋領域分割）と処理時間の上限
PHOTO_MAX_PROVIDER_CALLS=7
PHOTO_TIME_BUDGET_MS=25000
# 外部API停止時の表示確認用（mock のときだけ有効）
MOCK_FAIL=0
