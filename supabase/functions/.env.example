# supabase functions serve --env-file supabase/functions/.env
WORKER_SECRET=change-me
# rekognition | mock（開発用。実際の検出は行わない）
DETECTOR=mock
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DETECTOR_MIN_CONFIDENCE=60
# 写真解析 v2
# API には低めのスコアの候補まで返させ、アプリ側の min_score で数える
DETECTOR_CANDIDATE_MIN_CONFIDENCE=40
# 1ジョブあたりの外部API呼び出し上限（全体1回＋領域分割）と処理時間の上限
PHOTO_MAX_PROVIDER_CALLS=7
PHOTO_TIME_BUDGET_MS=25000
# 外部API停止時の表示確認用（mock のときだけ有効）
MOCK_FAIL=0
# メール送信（一斉配信・テスト送信・タスクの朝の通知）
#   本番（Gmail）：MAIL_TRANSPORT=smtp / SMTP_HOST=smtp.gmail.com / SMTP_PORT=465 / SMTP_SECURE=true
#                  SMTP_USER=Gmailアドレス / SMTP_PASS=アプリパスワード / MAIL_FROM=Gmailアドレス
#   Edge Functions は 25・587 番ポートに接続できないので 465 を使う
MAIL_TRANSPORT=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# 開封記録・配信停止リンクに使うアプリのURL
APP_URL=https://relationnote.vercel.app
MAIL_SEND_INTERVAL_MS=300
# 外部データのコネクト（Google フォーム・スプレッドシート）。Google Cloud の OAuth クライアント（ウェブアプリ）の値
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
